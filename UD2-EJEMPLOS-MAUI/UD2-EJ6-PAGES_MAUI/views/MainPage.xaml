<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UD2_EJ6_PAGES_MAUI.MainPage"
             Title="Taller lucena">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label Text="Neumaticos" FontSize="Large" />
            <ImageButton Source="neumaticos.jpg" Aspect="AspectFit" x:Name="IBtnTire" 
                         Clicked="IBtnTire_Clicked"/>

            <Label Text="Pedir cita" FontSize="Large"/>
            <ImageButton Source="cita.jpg" Aspect="AspectFit" x:Name="IBtnDate"
                         Clicked="IBtnDate_Clicked"/>

            <Label Text="Contacto" FontSize="Large" />
            <ImageButton Source="contacto.jpg" Aspect="AspectFit" x:Name="IBtnContact"
                         Clicked="IBtnContact_Clicked"/>


        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
